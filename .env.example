# --- Easiest: install Ollama, run a model, then: npm run setup:llm ---
# Or leave everything commented — Everix auto-detects Ollama on localhost.

# --- Or pick ONE provider (set LLM_PROVIDER + its API key) ---

# anthropic (paid; default if LLM_PROVIDER is unset)
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# google — free tier: https://aistudio.google.com/apikey
# LLM_PROVIDER=google
# GOOGLE_GENERATIVE_AI_API_KEY=
# LLM_MODEL=gemini-2.0-flash

# groq — free tier: https://console.groq.com/keys
# LLM_PROVIDER=groq
# GROQ_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile

# openrouter — many free models: https://openrouter.ai/keys
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# LLM_MODEL=google/gemini-2.0-flash-exp:free

# ollama — fully local & free (install Ollama, run: ollama pull llama3.2)
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
